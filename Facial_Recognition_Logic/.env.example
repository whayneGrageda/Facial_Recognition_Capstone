# Camera Settings
TIMEIN_CAMERA_INDEX=0
TIMEOUT_CAMERA_INDEX=1
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# Recognition Settings
KNOWN_FACES_PATH=known_faces
MODEL_PATH=models
SIMILARITY_THRESHOLD=0.36
MAX_FACES_PER_FRAME=4
PROCESS_EVERY_N_FRAMES=3
RECOGNITION_COOLDOWN=300

# Liveness Detection (Anti-Spoofing)
ENABLE_LIVENESS=True
LIVENESS_THRESHOLD=0.7
SPOOF_BLOCK_DURATION=10.0
SPOOF_INSTANT_THRESHOLD=0.4

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=facial_recognition
DB_USER=postgres
DB_PASSWORD=your_password_here
